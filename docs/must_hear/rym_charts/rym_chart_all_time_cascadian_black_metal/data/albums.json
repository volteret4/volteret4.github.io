[{"n":1,"title":"Ashes Against the Grain","artist":"Agalloch","year":2006,"mbid":"37859bb9-e60d-340c-83bd-1bc48ccdafb9","cover":"https://dn721806.ca.archive.org/0/items/mbid-1dd278bb-11ca-32ee-8ba5-711ddaf871a1/mbid-1dd278bb-11ca-32ee-8ba5-711ddaf871a1-1122863191.jpg","spotify_id":null,"spotify_url":"https://open.spotify.com/album/33yLuUJMwpcZmkAypX3IKp","desc_lfm_album":"Ashes Against the Grain is an album by American metal band Agalloch under the Brooklyn, New York-based label, The End Records. It is Agalloch's third full-length release, four years after the critically acclaimed The Mantle. Before the release, the track \"Falling Snow\" was made available in its entirety on the label's website and on the band's MySpace page. Reports indicate a version of the album was leaked on the web in May 2006. A pre-release review in the July 2006 issue of Toronto-based Exclaim! magazine described the new album as a \"departure and an extension\" from the band's previous work: .","desc_lfm_artist":"Agalloch is an American folk doom metal band formed in Portland, Oregon, United States in 1995.\n\nAfter two demo releases in the late 1990’s the band released three full-length albums: Pale Folklore (1999), The Mantle (2002), and Ashes Against the Grain (2006). “The Mantle” has since been heralded as a classic for having been one of the first albums to combine elements from black metal, neo-folk, progressive rock, post-rock, and ambient music. The influence of this record can be heard in the music of multiple “post-black metal” bands.","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"B1x8q64NXxA","genres":["doom metal","post-metal","black metal","atmospheric black metal","dark folk","folk metal"],"rym":"https://rateyourmusic.com/release/album/agalloch/ashes-against-the-grain","scaruffi_rating":7.0,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":86,"aoty_critic_score":93,"metacritic_score":null,"label":null},{"n":2,"title":"The Mantle","artist":"Agalloch","year":2002