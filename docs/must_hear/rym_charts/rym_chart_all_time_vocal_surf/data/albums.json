 experimental recording techniques.","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"eL7I0OCwhdk","genres":["surf"],"rym":"https://rateyourmusic.com/release/album/the-beach-boys/surfer-girl","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":3,"title":"Shut Down Volume 2","artist":"The Beach Boys","year":1964,"mbid":"74940c19-0669-304a-a59e-2f6aafb18f95","cover":"https://e.snmc.io/i/600/s/100390a1cbd9c71a6e90d597d29c6090/4468184/The%20Beach%20Boys%20-%20Shut%20Down%20Volume%202%2C%20Cover%20art.jpeg","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":"9Dcu_kWzWQE","genres":[],"rym":"https://rateyourmusic.com/release/album/the-beach-boys/shut-down-volume-2","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":4,"title":"Surfin' U.S.A.","artist":"The Beach Boys","year":1963,"mbid":"9a7228ff-f6f9-3d90-a39b-65a2f1dabade","cover":"https://e.snmc.io/i/600/s/0ed83f1a565883f159368657ac0b5588/4834811/The%20Beach%20Boys%20-%20Surfin'%20U_S_A_%2C%20Cover%20art.jpeg","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":"RvO7OxiK07c","genres":[],"rym":"https://rateyourmusic.com/release/album/the-beach-boys/surfin-u_s_a","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":5,"title":"The Little Old Lady From Pasadena","artist":"Jan & Dean","year":1964,"mbid":"9b745605-320e-4d33-8a4a-9c048060a08c","cover":"https://coverartarchive.org/release-group/9b745605-320e-4d33-8a4a-9c048060a08c/front-500","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":