[{"n":1,"title":"Q: Are We Not Men? A: We Are Devo!","artist":"DEVO","year":1978,"mbid":"60a754f9-50e1-346a-97db-925a1e2ad7e0","heard":true,"cover":"https://ia803403.us.archive.org/14/items/mbid-ac5e2d19-f8f2-43a0-8830-170f2e09677d/mbid-ac5e2d19-f8f2-43a0-8830-170f2e09677d-6453898327.jpg","spotify_id":null,"spotify_url":null,"desc_lfm_album":"Q: Are We Not Men? A: We Are Devo! is the debut studio album by the American new wave band Devo. It was originally released in August 1978, on the labels Warner Bros., and Virgin. Produced by Brian Eno, the album was recorded over a period of four months between October 1977 and February 1978, primarily in Cologne, Germany, The album received somewhat mixed reviews from critics and peaked at number 12 on the UK Albums Chart and number 78 on the U.S. Billboard chart. Recent reviews of the album have been more uniformly positive, and the album has charted .","desc_lfm_artist":"Devo are an American new wave band formed in Akron, Ohio in 1972. The band split in 1991 and returned in 1996. The band currently consists of Gerald Casale (vocals, bass), Mark Mothersbaugh (vocals, synthesizer), Bob Mothersbaugh (guitar), and Josh Freese (drums). Former members include Bob Casale (guitar, keyboards) (born July 14, 1952; died February 17, 2014) and Alan Myers (drums) (born 1955; died 2013). The band released their first album in 20 years, Something for Everybody on June 15, 2010.","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"a8UcpmUQkNU","genres":["art rock","post-punk","art punk","punk rock","new wave","zolo"],"rym":"https://rateyourmusic.com/release/album/devo/q-are-we-not-men-a-we-are-devo","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":2,"title":"Freedom of Choice","artist":"Devo","year":1980,"mbid":"bb889709-d775-3cb1-84c2-1daf4884e165","heard":false,"cover":"https://coverartarchive.org/release-group/bb889709-d775-3cb1-84