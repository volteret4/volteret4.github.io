 as a result of singing with Paul Simon on his 1986 album Graceland, and have won multiple awards, including four Grammy Awards. They have become one of South Africa's most prolific recording artists, with their releases receiving gold and platinum disc honors","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"X2xl2fsdyGM","genres":["folk","isicathamiya","mbube","folk, world, & country"],"rym":"https://rateyourmusic.com/release/album/ladysmith-black-mambazo/shaka-zulu/","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":3,"title":"Wasalala","artist":"Madalitso Band","year":2019,"mbid":"87ba0f75-19fa-4651-bcde-5b699fc9fb9b","heard":false,"cover":"https://coverartarchive.org/release-group/87ba0f75-19fa-4651-bcde-5b699fc9fb9b/front-500","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":"LRFx-fGWvmQ","genres":[],"rym":"https://rateyourmusic.com/release/album/madalitso-band/wasalala","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":4,"title":"Hymns of Bantu","artist":"Abel Selaocoe","year":2025,"mbid":"cc516822-a543-465c-a416-087074144d3e","heard":false,"cover":"https://coverartarchive.org/release-group/cc516822-a543-465c-a416-087074144d3e/front-500","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":"Mz4vAcFkBEk","genres":[],"rym":"https://rateyourmusic.com/release/album/abel-selaocoe/hymns-of-bantu","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":5,"title":"White Night","artist":"Stephan Micus","year":2019,"mbid":"674c7353-80d9-45cc-b747-b993ce0c9e6b","heard":false,"cover":"https://coverarta