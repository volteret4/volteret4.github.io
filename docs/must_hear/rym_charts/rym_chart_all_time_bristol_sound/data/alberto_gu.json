[{"n":1,"title":"Dummy","artist":"Portishead","year":1994,"mbid":"48140466-cff6-3222-bd55-63c27e43190d","heard":true,"cover":"https://dn711103.ca.archive.org/0/items/mbid-76df3287-6cda-33eb-8e9a-044b5e15ffdd/mbid-76df3287-6cda-33eb-8e9a-044b5e15ffdd-829521842.jpg","spotify_id":null,"spotify_url":"https://open.spotify.com/album/3539EbNgIdEDGBKkUf4wno","desc_lfm_album":"Dummy is the debut studio album by English band Portishead, released on August 22, 1994 by Go! Beat Records. The album is often credited with popularising the trip hop genre and is frequently cited in lists of the best albums of the 1990s. \"Numb\" was released on June 6, 1994 as the album's lead single, followed by \"Sour Times\" in August of the same year and \"Glory Box\" in January 1995. The tracks \"Roads\" and \"Strangers\" were used in the soundtrack of the 1994 horror film Nadja. .","desc_lfm_artist":"Portishead is an English band formed in 1991 in Bristol. Portishead are named after Portishead, Somerset, eight miles west of Bristol, along the coast. The band comprises vocalist Beth Gibbons, producer Geoff Barrow and musician Adrian Utley.\n\nPortishead's debut album, Dummy (1994), fused hip hop production with an atmospheric, cinematic style reminiscent of spy film soundtracks. The album was met with commercial and critical acclaim, quickly becoming a landmark album in the emerging trip hop genre.","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"GxWgRnnWfcc","genres":["trip hop","acid jazz","Electronic"],"rym":"https://rateyourmusic.com/release/album/portishead/dummy","scaruffi_rating":8.0,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":90,"aoty_critic_score":92,"metacritic_score":87,"label":"Go! Discs"},{"n":2,"title":"Mezzanine","artist":"Massive Attack","year":1998,"mbid":"6f9f6899-c0d3-311d-ae87-a10ae6bc53a9","heard":false,"cover":"https://dn710600.ca.archive.org/0/items/mbid-6e512ec0-1316-4abb-b6b6-07dbd8b005ed/mbid-6e512ec0-1316-4abb-b6b6-07dbd8b005ed-12203062606.png","spotify_id":null,"spotify_url":"https://open.spotify.com/album/49MNmJhZQewjt06rpwp6QR","desc_lfm_album":"Mezzanine is the third studio album by English electronic music group Massive Attack, released on 20 April 1998 by Circa and Virgin Records. Produced by Massive Attack and Neil Davidge, it saw the duo expanding their trip hop sound to electronica stylings, with diverse influences from new wave, rock, hip hop, and dub music. Mezzanine topped the charts in the United Kingdom, Australia, Ireland, and New Zealand, becoming the group's most commercially successful album to date. It spawned four singles: Risingson, Teardrop, Angel, and Inertia Creeps. Background The production of Mezzanine was a stressful process. With tensions arising within the .","desc_lfm_artist":"Massive Attack is an English trip hop collective formed in 1988 in Bristol by Robert \"3D\" Del Naja, Grant \"Daddy G\" Marshall, Adrian \"Tricky\" Thaws and Andrew \"Mushroom\" Vowles. The group consists of Del Naja and Marshall.\n\nTheir debut album, \"Blue Lines\" (1991), is frequently cited as the first major work of the trip hop genre. The single \"Unfinished Sympathy\" achieved chart success in Europe, including reaching number one on the Dutch Top 40. Their second album","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"fQtyrAEjHAU","genres":["dub","electronica","leftfield","trip hop","post-industrial","alternative dance"],"rym":"https://rateyourmusic.com/release/album/massive-attack/mezzanine","scaruffi_rating":7.0,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":89,"aoty_critic_score":87,"metacritic_score":null,"label":"Circa Records"},{"n":3,"title":"Portishead","artist":"Portishead","year":1997,"mbid":"7685a5d0-3dac-40c7-b26d-544636129979","heard":false,"cover":"https://cdn2.albumoftheyear.org/600x0/album/2553-portishead_144455.jpg","spotify_id":null,"spotify_url":null,"desc_lfm_album":"Portishead is the second studio album by English band Portishead, released on September 16, 1997 by Go! Discs. With Portishead, the band chose to eschew sampling other records, which had a defining feature of their debut album Dummy. Instead, they created original pieces which they weaved into the songs, resulting in a more textured sound. The only song to employ samples was \"Only You\", which incorporates elements of Ken Thorne's \"Inspector Clouseau\" and The Pharcyde's \"She Said\". .","desc_lfm_artist":"Portishead is an English band formed in 1991 in Bristol. Portishead are named after Portishead, Somerset, eight miles west of Bristol, along the coast. The band comprises vocalist Beth Gibbons, producer Geoff Barrow and musician Adrian Utley.\n\nPortishead's debut album, Dummy (1994), fused hip hop production with an atmospheric, cinematic style reminiscent of spy film soundtracks. The album was met with commercial and critical acclaim, quickly becoming a landmark album in the emerging trip hop genre.","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"FBXGd81YNzc","genres":["Electronic"],"rym":"https://rateyourmusic.com/release/album/portishead/portishead","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":84,"aoty_critic_score":82,"metacritic_score":null,"label":null},{"n":4,"title":"Blue Lines","artist":"Massive Attack","year":1991,"mbid":"8b6f133a-2fdf-3cc2-b84d-1c889adc0939","heard":false,"cover":"https://dn711308.ca.archive.org/0/items/mbid-3a25785e-50ec-383c-89cf-fd512181449c/mbid-3a25785e-50ec-383c-89cf-fd512181449c-2233107692.jpg","spotify_id":null,"spotify_url":null,"desc_lfm_album":"Blue Lines is the debut studio album by English electronic music group Massive Attack, released on April 8, 1991 by Wild Bunch and Virgin Records. Generally regarded as the first \"trip hop\" album, Blue Lines blended elements of hip hop (such as breakbeats, sampling and rapping) with dub, soul, reggae and electronic music. The recording was led by members Grantley \"Daddy G\" Marshall, Robert \"3D\" Del Naja, Adrian \"Tricky\" Thaws and Andrew \"Mushroom\" Vowles, with co-production by Jonny Dollar. It also features contributions by singers Shara Nelson and Horace Andy. Blue Lines was named the 21st greatest album of all .","desc_lfm_artist":"Massive Attack is an English trip hop collective formed in 1988 in Bristol by Robert \"3D\" Del Naja, Grant \"Daddy G\" Marshall, Adrian \"Tricky\" Thaws and Andrew \"Mushroom\" Vowles. The group consists of Del Naja and Marshall.\n\nTheir debut album, \"Blue Lines\" (1991), is frequently cited as the first major work of the trip hop genre. The single \"Unfinished Sympathy\" achieved chart success in Europe, including reaching number one on the Dutch Top 40. Their second album","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"W5UIf9CRXNI","genres":["alternative rock","dub","electronica","trip hop","hip hop","alternative dance"],"rym":"https://rateyourmusic.com/release/album/massive-attack/blue-lines","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":82,"aoty_critic_score":96,"metacritic_score":87,"label":"Circa Records"},{"n":5,"title":"Maxinquaye","artist":"Tricky","year":1995,"mbid":"9fd2415f-182f-39c1-aa02-5acb36f99bef","heard":false,"cover":"https://dn710102.ca.archive.org/0/items/mbid-849315e1-c3ee-4c1b-955a-a53a1a009e63/mbid-849315e1-c3ee-4c1b-955a-a53a1a009e63-40597098441.jpg","spotify_id":null,"spotify_url":null,"desc_lfm_album":"Maxinquaye is the debut album of Tricky, released in 1995. Expanding on the sonic template of fellow Bristolians Massive Attack, and featuring then-girlfriend Martina Topley-Bird on vocals, Maxinquaye is a dark, mysterious album featuring a combination of hip-hop, soul, dub, rock and electronica. The album was later released in America and received great critical acclaim. The album is named after Tricky's late mother Maxine Quaye, who is thought to be reggae/soul singer Finley Quaye's half-sister .","desc_lfm_artist":"Adrian Thaws (born 27 January 1968), better known as Tricky, is a rapper and musician from Knowle West, Bristol, England who is important in the trip-hop scene (despite loathing the tag) and remains influential on the British scene more generally.\n\nHe is noted for an asthmatic whispering lyrical style that is half-rapped, half-sung. As a producer and a musician he is known for having an aversion to perfection preferring to build up a dark, rich and layered sound.","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"J_r2HZqw06E","genres":["psychedelic","dub","r&b","electronica","post-rock","trip hop"],"rym":"https://rateyourmusic.com/release/album/tricky/maxinquaye","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":81,"aoty_critic_score":91,"metacritic_score":null,"label":"Island"},{"n":6,"title":"Protection","artist":"Massive Attack","year":1994,"mbid":"ded46e46-788d-3c1f-b21b-9f5e9c37b1bc","heard":false,"cover":"https://dn710806.ca.archive.org/0/items/mbid-50d1ca93-f6ef-4692-b18d-3e3cc29aba1e/mbid-50d1ca93-f6ef-4692-b18d-3e3cc29aba1e-19647449808.jpg","spotify_id":null,"spotify_url":null,"desc_lfm_album":"Protection is the second studio album by English electronic music group Massive Attack, released on September 26, 1994 by Wild Bunch Records and Circa. Like most of Massive Attack's albums, the music often defies categorisation, ranging from R&B to hip hop/rap to reggae-tinged synth-pop to classical-influenced electronica instrumentals. The album follows Blue Lines structurally, to the point that the font used on the cover of the album is the same, Helvetica Heavy Italic. The album cover also nods to Blue Lines, revealing a futuristic, impenetrable wall behind a mostly-burned version of this previous album's artwork—implying that the depicted \"flammable gas\" .","desc_lfm_artist":"Massive Attack is an English trip hop collective formed in 1988 in Bristol by Robert \"3D\" Del Naja, Grant \"Daddy G\" Marshall, Adrian \"Tricky\" Thaws and Andrew \"Mushroom\" Vowles. The group consists of Del Naja and Marshall.\n\nTheir debut album, \"Blue Lines\" (1991), is frequently cited as the first major work of the trip hop genre. The single \"Unfinished Sympathy\" achieved chart success in Europe, including reaching number one on the Dutch Top 40. Their second album","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"Q6mET3eSSN8","genres":["dub","electronica","trip hop","alternative dance","electronic"],"rym":"https://rateyourmusic.com/release/album/massive-attack/protection","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":79,"aoty_critic_score":77,"metacritic_score":null,"label":"Circa Records"},{"n":7,"title":"Bloom","artist":"Crustation &","year":1997,"mbid":"2a46ca4f-2f41-3b99-841f-d96e65972378","heard":false,"cover":"https://coverartarchive.org/release-group/2a46ca4f-2f41-3b99-841f-d96e65972378/front-500","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":"F0UKWz5O9MA","genres":[],"rym":"https://rateyourmusic.com/release/album/crustation-with-bronagh-slevin/bloom","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":8,"title":"Nearly God","artist":"Nearly God","year":1996,"mbid":"744e6bca-0dad-31ec-b044-ffec4758d561","heard":false,"cover":"https://coverartarchive.org/release-group/744e6bca-0dad-31ec-b044-ffec4758d561/front-500","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":"PGGPmMZoShg","genres":[],"rym":"https://rateyourmusic.com/release/album/nearly-god/nearly-god","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":9,"title":"Compassion","artist":"Broadway Project","year":2000,"mbid":"301ff110-0b33-3c77-b743-7102bc8d5d7d","heard":false,"cover":"https://coverarta