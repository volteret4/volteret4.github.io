[{"n":1,"title":"Floral Green","artist":"Title Fight","year":2012,"mbid":"fa2a6003-18d9-48d4-971a-f0608154f076","cover":"https://cdn2.albumoftheyear.org/600x0/album/floral-green.jpg","spotify_id":null,"spotify_url":null,"desc_lfm_album":"Floral Green is the second studio album by Pennsylvanian band Title Fight in 2012, the album was produced by Will Yip at Studio 4 in Conshohocken in the same state the band hails from. The album was released on September 18th, 2012. Coming in around 32 minutes with 11 tracks, the album received positive reviews across the board, and is hailed as their best by most fans. .","desc_lfm_artist":"Title Fight was an American punk rock band from Kingston, Pennsylvania, formed in 2003. The band was comprised of Jamie Rhoden (vocals, guitar), Shane Moran (guitar) and brothers Ned (vocals, bass) and Ben Russin (drums). Title Fight plays music in the vein of Jawbreaker, Kid Dynamite and Lifetime; taking influence from such melodic punk rock acts as Saves the Day, emo bands Knapsack and Seaweed, and, more recently, indie rock acts like Dinosaur Jr. and My Bloody Valentine.","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"5MzO27DIisM","genres":[],"rym":"https://rateyourmusic.com/release/album/title-fight/floral-green","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":83,"aoty_critic_score":75,"metacritic_score":null,"label":null},{"n":2,"title":"Wildlife","artist":"La Dispute","year":2011,"mbid":"56b3b007-8332-4a42-b074-2d8b04cdadf1","cover":"https://cdn2.albumoftheyear.org/600x0/album/5047-wildlife_011239.jpg","spotify_id":null,"spotify_url":null,"desc_lfm_album":"Wildlife is the second studio album by American post-hardcore band La Dispute, released October 4, 2011, on No Sleep Records. Recording sessions for the album took place primarily at StadiumRed in New York in April 2011. The band members of La Dispute took control of all of the production duties alongside the album's recording engineers Andrew Everding and Joseph Pedulla. Noted by music writers for its varied elements, Wildlife incorporates musical components from La Dispute's previous releases, particularly Somewhere at the Bottom of the River Between Vega and Altair and Here, Hear III., and genres such as screamo, progressive rock, .","desc_lfm_artist":"La Dispute is an American post-hardcore band from Grand Rapids, Michigan, formed in 2004. The current lineup is vocalist Jordan Dreyer, drummer Brad Vander Lugt, guitarist Chad Morgan-Sterenberg, guitarist Corey Stroffolino and bass guitarist Adam Vass. With a firm passion for the concept of music and art as a medium for making new friends, La Dispute makes music that is both artistically, technically, and emotionally engaging in hopes of establishing legitimate connections with any and all interested people","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"LvqNmyJPTyk","genres":[],"rym":"https://rateyourmusic.com/release/album/la-dispute/wildlife","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":86,"aoty_critic_score":80,"metacritic_score":null,"label":null},{"n":3,"title":"Shed","artist":"Title Fight","year":2011,"mbid":"abc44a88-a89a-4809-87f7-5064001b015d","cover":"https://cdn2.albumoftheyear.org/600x0/album/27155-shed-1.jpg","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":"Title Fight was an American punk rock band from Kingston, Pennsylvania, formed in 2003. The band was comprised of Jamie Rhoden (vocals, guitar), Shane Moran (guitar) and brothers Ned (vocals, bass) and Ben Russin (drums). Title Fight plays music in the vein of Jawbreaker, Kid Dynamite and Lifetime; taking influence from such melodic punk rock acts as Saves the Day, emo bands Knapsack and Seaweed, and, more recently, indie rock acts like Dinosaur Jr. and My Bloody Valentine.","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"wNelda9rRo4","genres":[],"rym":"https://rateyourmusic.com/release/album/title-fight/shed","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":82,"aoty_critic_score":78,"metacritic_score":null,"label":null},{"n":4,"title":"Somewhere at the Bottom of the River Between Vega and Altair","artist":"La Dispute","year":2008,"mbid":"ab152f07-4fb8-3068-951d-47720622ac6d","cover":"https://dn710001.ca.archive.org/0/items/mbid-6c91ff0c-d946-49c4-b4cc-d24b51da9ada/mbid-6c91ff0c-d946-49c4-b4cc-d24b51da9ada-38786027640.jpg","spotify_id":null,"spotify_url":"https://open.spotify.com/album/5fzDxefGUH8jM7T9HCLSNr","desc_lfm_album":"Somewhere at the Bottom of the River Between Vega and Altair is La Dispute's debut album. Supported by three release shows, it was released on November 11, 2008, simultaneously along with Here, Hear II. through No Sleep Records on both CD and vinyl. The album's title is derived from an Asian folktale, which the album's lyrics loosely follow. The release received positive reviews from notable critics and maintains a legacy in the post-hardcore scene. .","desc_lfm_artist":"La Dispute is an American post-hardcore band from Grand Rapids, Michigan, formed in 2004. The current lineup is vocalist Jordan Dreyer, drummer Brad Vander Lugt, guitarist Chad Morgan-Sterenberg, guitarist Corey Stroffolino and bass guitarist Adam Vass. With a firm passion for the concept of music and art as a medium for making new friends, La Dispute makes music that is both artistically, technically, and emotionally engaging in hopes of establishing legitimate connections with any and all interested people","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"ESWuv5x7vsA","genres":["progressive rock","spoken word","punk","post-hardcore","post-rock","emo"],"rym":"https://rateyourmusic.com/release/album/la-dispute/somewhere-at-the-bottom-of-the-river-between-vega-and-altair","scaruffi_rating":7.0,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":84,"aoty_critic_score":80,"metacritic_score":null,"label":null},{"n":5,"title":"Stage Four","artist":