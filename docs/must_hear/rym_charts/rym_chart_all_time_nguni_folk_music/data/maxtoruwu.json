 as a result of singing with Paul Simon on his 1986 album Graceland, and have won multiple awards, including four Grammy Awards. They have become one of South Africa's most prolific recording artists, with their releases receiving gold and platinum disc honors","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"X2xl2fsdyGM","genres":["folk","isicathamiya","mbube","folk, world, & country"],"rym":"https://rateyourmusic.com/release/album/ladysmith-black-mambazo/shaka-zulu/","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":3,"title":"Udondolo","artist":"Urban Village","year":2021,"mbid":"1699c42e-7731-4825-b1d6-e5dd54107fb9","heard":false,"cover":"https://coverartarchive.org/release-group/1699c42e-7731-4825-b1d6-e5dd54107fb9/front-500","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":"0MSKYQgOK1I","genres":[],"rym":"https://rateyourmusic.com/release/album/urban-village/udondolo","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":4,"title":"The Zulu Songs of Princess Constance Magogo KaDinuzulu","artist":"Princess Constance Magogo kaDinuzulu","year":2000,"mbid":null,"heard":false,"cover":"","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":"urOeTaZetcY","genres":[],"rym":"https://rateyourmusic.com/release/album/princess-constance-magogo-kadinuzulu/the-zulu-songs-of-princess-constance-magogo-kadinuzulu","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":5,"title":"Sankofa","artist":"Thandiswa","year":2024,"mbid":"b12a20f3-b848-47b7-b1b2-4bf8cdcec1ff","heard":false,"cover":"https://coverartarchive